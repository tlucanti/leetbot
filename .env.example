# Create a bot with https://t.me/BotFather and put its token here.
TELEGRAM_BOT_TOKEN=replace_with_your_bot_token

# Target group. Leave blank initially and use /start in the group to find its ID.
# Set this value and restart the bot to enable tracking.
TELEGRAM_CHAT_ID=

# How often to check LeetCode (seconds; minimum 10).
POLL_INTERVAL_SECONDS=60

# Relative paths are resolved from this project folder.
DATA_DIR=data
